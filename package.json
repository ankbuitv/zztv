{
  "name": "playz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "playZ — premium OTT platform (consumer app, admin app, Cloudflare Worker API)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @playz/web",
    "dev:admin": "npm run dev -w @playz/admin",
    "dev:api": "wrangler dev -c wrangler.dev.toml --ip 0.0.0.0 --port 8787",
    "dev:fixture": "node tools/dev-api.mjs",
    "dev:offline": "node tools/dev-api.mjs & VITE_DEV_API_TARGET=http://127.0.0.1:8788 VITE_TMDB_IMG_BASE=/img npm run dev -w @playz/web",
    "build": "npm run build:web && npm run build:admin",
    "build:web": "npm run build -w @playz/web",
    "build:admin": "npm run build -w @playz/admin",
    "preview": "npm run preview -w @playz/web",
    "preview:admin": "npm run preview -w @playz/admin",
    "deploy": "wrangler deploy",
    "deploy:api": "wrangler deploy -c wrangler.api.toml",
    "deploy:admin": "wrangler deploy -c wrangler.admin.toml",
    "deploy:license": "wrangler deploy -c wrangler.license.toml",
    "deploy:check": "npm run build && npm run verify:assets && npm run db:baseline:check",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:status": "wrangler d1 migrations list DB --remote",
    "db:baseline": "node scripts/gen-d1-baseline.mjs",
    "db:baseline:check": "node scripts/gen-d1-baseline.mjs --check",
    "verify:assets": "node scripts/verify-assets.mjs",
    "brand": "node scripts/build-brand.mjs",
    "secrets:check": "node scripts/secret-scan.mjs",
    "secrets:put": "bash scripts/put-secrets.sh",
    "test": "node scripts/deploy-check.mjs",
    "test:smoke": "node scripts/smoke-app.mjs",
    "test:all": "npm test && npm run test:smoke"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
