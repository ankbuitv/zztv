# ============================================================================
# playZ — environment template
#
# COPY this file to `.env` and fill in real values. NEVER commit `.env`.
#
#   cp .env.example .env
#
# Background: the original repository committed a real TMDB key in `.env`, in
# `.env.example` and hardcoded in `worker/worker.js`. The owner has asked that
# their keys stay where they put them, so the key is back in all three places.
#
# It is in the public history of the original repo, so treat it as known to
# others: rotate it at themoviedb.org if the quota is ever abused, then set it
# with `wrangler secret put TMDB_KEY` — an env value overrides the literal.
# ============================================================================

# ---------------------------------------------------------------------------
# BUILD-TIME (Vite, exposed to the browser bundle — never put secrets here)
# ---------------------------------------------------------------------------

# TMDB API key for the Movies section.
# Get one free: https://www.themoviedb.org/settings/api  (see docs/legacy-TMDB.md)
VITE_TMDB_KEY=c02e885e3955667731c6267bd30fa92d

# API base URL. Leave EMPTY in production when the Worker serves the built app
# on the same origin (recommended — no CORS involved).
# Only set this when the web app and the API live on different hostnames.
VITE_API_BASE=

# Dev only: where the Vite dev server proxies /api, /auth, /user, /admin, /ws.
# Defaults to the production API. To test a local Worker:
#   npm run dev:api
#   VITE_DEV_API_TARGET=http://127.0.0.1:8787 npm run dev
VITE_DEV_API_TARGET=

# ---------------------------------------------------------------------------
# RUNTIME (Cloudflare Worker secrets — set with `wrangler secret put <NAME>`)
# These are NOT read from .env by Wrangler. Listed here for documentation.
# ---------------------------------------------------------------------------

# --- core auth (generate each: openssl rand -base64 48) ---
# JWT_SECRET=                  # signs session JWTs. Rotating it only revokes sessions.
# PASSWORD_PEPPER=             # separate pepper for password hashes. NEVER rotate blindly.
# STREAM_TOKEN_SECRET=         # HMAC for short-lived playback tokens.

# --- optional rotation support (comma-separated, oldest last) ---
# LEGACY_JWT_SECRETS=
# LEGACY_PASSWORD_PEPPERS=

# --- admin ---
# ADMIN_MASTER_TOKEN=          # break-glass admin token. Keep long and random.
# ADMIN_ALLOWED_CIDRS=         # e.g. 1.2.3.4/32,5.6.7.0/24 — empty = no IP restriction.

# --- streaming ---
# STREAM_MODE=direct           # direct | auto | proxy  (see docs/legacy-CHONG_RIP_STREAM.md)
# PROTECT=off
# PROXY_ALLOWED_HOSTS=         # comma-separated allowlist for the SSRF-guarded proxy
# LICENSE_SECRET=
# LICENSE_BASE=
# UPSTREAM_UA_DEFAULT=

# --- third-party APIs ---
# TMDB_KEY=                    # REQUIRED for Movies. Server-side only.
# TSDB_KEY=                    # TheSportsDB (optional; free tier key works)
# BREVO_API_KEY=               # transactional email (verify/reset)
# BREVO_SENDER_EMAIL=noreply@thelac.dpdns.org
# BREVO_SENDER_NAME=playZ
# TELEGRAM_BOT_TOKEN=          # health/alert notifications (optional)
# TELEGRAM_CHAT_ID=
# ADMIN_ALERT_WEBHOOK=
# GITHUB_RAW_TOKEN=            # only if a private playlist repo is used

# --- web push (VAPID) ---
# Generate a keypair, then expose the public half to the client.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# --- community / realtime ---
# CORS_ALLOWED_ORIGINS=        # comma-separated. e.g. https://thelac.dpdns.org,https://admin.thelac.dpdns.org
# CHAT_SLOWMODE_SECONDS=3

# ---------------------------------------------------------------------------
# CLOUDFLARE (used by wrangler, not by the app)
# ---------------------------------------------------------------------------
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
